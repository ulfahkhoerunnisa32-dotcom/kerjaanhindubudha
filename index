<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nusantara Heritage - Media Pembelajaran Sejarah Interaktif Kelas X</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome for Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts - Fredoka & Plus Jakarta Sans -->
    <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        display: ['Fredoka', 'sans-serif'],
                        body: ['Plus Jakarta Sans', 'sans-serif'],
                    },
                    colors: {
                        pastel: {
                            blue: '#E0F2FE',
                            indigo: '#EEF2FF',
                            purple: '#F3E8FF',
                            pink: '#FCE7F3',
                            amber: '#FEF3C7',
                            emerald: '#D1FAE5',
                            cream: '#FFFBEB'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #FAF5FF;
        }
        h1, h2, h3, h4, .font-fun {
            font-family: 'Fredoka', cursive;
        }
        .tab-btn.active {
            background-color: #4F46E5;
            color: #ffffff;
            box-shadow: 0 10px 15px -3px rgba(79, 70, 229, 0.3);
            transform: translateY(-2px);
        }
        .bubble-card {
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .bubble-card:hover {
            transform: translateY(-6px) scale(1.02);
        }
        .custom-scrollbar::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }
        .custom-scrollbar::-webkit-scrollbar-track {
            background: #F3E8FF;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: #C084FC;
            border-radius: 10px;
        }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover {
            background: #A855F7;
        }
    </style>
</head>
<body class="text-slate-700 antialiased min-h-screen flex flex-col justify-between selection:bg-pink-200 selection:text-indigo-900">

    <!-- HEADER / NAVIGATION -->
    <header class="bg-gradient-to-r from-indigo-600 via-purple-600 to-pink-500 text-white shadow-xl sticky top-0 z-50 rounded-b-3xl">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3.5 flex flex-wrap justify-between items-center">
            <div class="flex items-center space-x-3">
                <div class="bg-amber-300 p-2.5 rounded-2xl text-indigo-950 font-bold text-2xl shadow-md rotate-3 hover:rotate-0 transition-transform">
                    🗿
                </div>
                <div>
                    <h1 class="font-extrabold text-xl sm:text-2xl tracking-wide leading-none flex items-center gap-2">
                        Nusantara Heritage <span class="text-amber-300 text-xs bg-indigo-950/40 px-2.5 py-1 rounded-full font-body font-semibold">Kelas X</span>
                    </h1>
                    <p class="text-xs text-pink-100 font-medium mt-1">Petualangan Sejarah Interaktif • Deep Learning</p>
                </div>
            </div>
            
            <div class="mt-2 sm:mt-0 flex items-center space-x-2">
                <span class="bg-white/20 backdrop-blur-md text-white text-xs px-3.5 py-1.5 rounded-full border border-white/30 flex items-center gap-1.5 font-semibold">
                    <i class="fa-solid fa-wand-magic-sparkles text-amber-300"></i> Mode Belajar Asyik
                </span>
            </div>
        </div>
        
        <!-- NAV TABS -->
        <nav class="bg-indigo-950/30 backdrop-blur-md px-4 rounded-b-3xl border-t border-white/10">
            <div class="max-w-7xl mx-auto flex space-x-2 overflow-x-auto py-2.5 text-xs sm:text-sm font-semibold custom-scrollbar">
                <button onclick="switchTab('beranda')" id="tab-beranda" class="tab-btn active px-4 py-2 rounded-2xl transition-all flex items-center gap-2 whitespace-nowrap">
                    <i class="fa-solid fa-house text-amber-300"></i> Beranda & Orientasi
                </button>
                <button onclick="switchTab('memahami')" id="tab-memahami" class="tab-btn px-4 py-2 rounded-2xl transition-all flex items-center gap-2 text-indigo-100 hover:text-white hover:bg-white/10 whitespace-nowrap">
                    <i class="fa-solid fa-map-location-dot text-sky-300"></i> 1. Memahami & Galeri
                </button>
                <button onclick="switchTab('mengaplikasi')" id="tab-mengaplikasi" class="tab-btn px-4 py-2 rounded-2xl transition-all flex items-center gap-2 text-indigo-100 hover:text-white hover:bg-white/10 whitespace-nowrap">
                    <i class="fa-solid fa-users-viewfinder text-emerald-300"></i> 2. Mengaplikasi
                </button>
                <button onclick="switchTab('merefleksi')" id="tab-merefleksi" class="tab-btn px-4 py-2 rounded-2xl transition-all flex items-center gap-2 text-indigo-100 hover:text-white hover:bg-white/10 whitespace-nowrap">
                    <i class="fa-solid fa-heart text-pink-300"></i> 3. Merefleksi
                </button>
                <button onclick="switchTab('game')" id="tab-game" class="tab-btn px-4 py-2 rounded-2xl transition-all flex items-center gap-2 text-indigo-100 hover:text-white hover:bg-white/10 whitespace-nowrap">
                    <i class="fa-solid fa-gamepad text-amber-300"></i> Kuis Fun Game
                </button>
                <button onclick="switchTab('tanya-guru')" id="tab-tanya-guru" class="tab-btn px-4 py-2 rounded-2xl transition-all flex items-center gap-2 text-indigo-100 hover:text-white hover:bg-white/10 whitespace-nowrap">
                    <i class="fa-solid fa-robot text-purple-300"></i> Tanya Guru AI
                </button>
            </div>
        </nav>
    </header>

    <!-- MAIN CONTENT CONTAINER -->
    <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 flex-grow w-full">

        <!-- SECTION 0: BERANDA & ORIENTASI -->
        <section id="sec-beranda" class="space-y-8">
            <!-- Hero Banner -->
            <div class="bg-gradient-to-r from-purple-600 via-indigo-600 to-pink-500 text-white rounded-3xl p-6 sm:p-10 shadow-2xl relative overflow-hidden">
                <div class="absolute -right-10 -bottom-10 opacity-20 text-[180px] select-none">🛕</div>
                <div class="relative z-10 max-w-3xl">
                    <span class="bg-amber-300 text-indigo-950 font-bold text-xs uppercase px-3.5 py-1.5 rounded-full tracking-wider shadow-sm">
                        ✨ Modul Ajar Deep Learning SMA Kelas X
                    </span>
                    <h2 class="text-3xl sm:text-5xl font-extrabold mt-4 mb-3 leading-tight font-fun">
                        Menjelajah Kejayaan Hindu-Buddha & Jejaknya Hari Ini! 🌟
                    </h2>
                    <p class="text-purple-100 text-sm sm:text-base leading-relaxed mb-8">
                        Tahukah kamu kalau semboyan <i>"Bhinneka Tunggal Ika"</i>, istilah <i>"Pancasila"</i>, hingga sistem pengelolaan air dan pelabuhan modern berasal dari warisan kerajaan Hindu-Buddha? Yuk, jelajahi kisah serunya!
                    </p>
                    <div class="flex flex-wrap gap-4">
                        <button onclick="switchTab('memahami')" class="bg-amber-400 hover:bg-amber-300 text-indigo-950 font-extrabold px-6 py-3.5 rounded-2xl shadow-xl transition-all transform hover:scale-105 flex items-center gap-2 font-fun text-base">
                            🚀 Mulai Petualangan!
                        </button>
                        <button onclick="openModalGuru()" class="bg-white/20 hover:bg-white/30 text-white font-semibold px-5 py-3.5 rounded-2xl border border-white/30 backdrop-blur-md transition-all text-sm flex items-center gap-2">
                            <i class="fa-solid fa-graduation-cap"></i> Panduan Guru & Diferensiasi
                        </button>
                    </div>
                </div>
            </div>

            <!-- Alur Deep Learning 3M (Cute Cards) -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="bg-white p-6 rounded-3xl border-2 border-sky-100 shadow-xl shadow-sky-50 bubble-card relative overflow-hidden">
                    <div class="w-14 h-14 bg-sky-100 text-sky-600 rounded-2xl flex items-center justify-center font-bold text-2xl mb-4 font-fun">
                        1 💡
                    </div>
                    <h3 class="font-bold text-xl text-slate-800 mb-2 font-fun">Memahami (Understand)</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Menghubungkan prasasti, candi, dan kitab kuno dari Kutai hingga Majapahit dengan kosakata & gaya hidup modernmu!
                    </p>
                </div>

                <div class="bg-white p-6 rounded-3xl border-2 border-emerald-100 shadow-xl shadow-emerald-50 bubble-card relative overflow-hidden">
                    <div class="w-14 h-14 bg-emerald-100 text-emerald-600 rounded-2xl flex items-center justify-center font-bold text-2xl mb-4 font-fun">
                        2 🤝
                    </div>
                    <h3 class="font-bold text-xl text-slate-800 mb-2 font-fun">Mengaplikasi (Apply)</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Tugas kelompok seru berdiferensiasi: Membuat komik infografis, rekaman podcast drama, atau analisis toleransi sosial.
                    </p>
                </div>

                <div class="bg-white p-6 rounded-3xl border-2 border-pink-100 shadow-xl shadow-pink-50 bubble-card relative overflow-hidden">
                    <div class="w-14 h-14 bg-pink-100 text-pink-600 rounded-2xl flex items-center justify-center font-bold text-2xl mb-4 font-fun">
                        3 ❤️
                    </div>
                    <h3 class="font-bold text-xl text-slate-800 mb-2 font-fun">Merefleksi (Reflect)</h3>
                    <p class="text-slate-600 text-sm leading-relaxed">
                        Mengambil nilai positif toleransi, kerja keras, dan keterbukaan dari para pendahulu Nusantara untuk bekal hidupmu.
                    </p>
                </div>
            </div>
        </section>

        <!-- SECTION 1: MEMAHAMI & GALERI PENINGGALAN KERBAIKAN -->
        <section id="sec-memahami" class="hidden space-y-8">
            <!-- Title Header -->
            <div class="bg-white p-6 sm:p-8 rounded-3xl border-2 border-purple-100 shadow-lg">
                <div class="flex items-center space-x-3 mb-3">
                    <span class="bg-sky-100 text-sky-800 font-bold px-4 py-1.5 rounded-full text-xs font-fun">Tahap 1: Memahami</span>
                    <h2 class="text-2xl sm:text-3xl font-bold text-slate-800 font-fun">Galeri Peninggalan & Relevansi Sehari-hari 🖼️</h2>
                </div>
                <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
                    Eksplorasi artefak peninggalan kerajaan Hindu-Buddha berdasarkan periode sejarahnya. Klik atau amati peninggalannya untuk menemukan kisah menarik di baliknya!
                </p>
            </div>

            <!-- PERIODE 1: AWAL NUSANTARA (ABAD 4 - 5 M) -->
            <div class="space-y-4">
                <div class="flex items-center gap-3">
                    <span class="bg-amber-400 text-indigo-950 font-bold px-3.5 py-1 rounded-2xl text-xs font-fun">PERIODE 1</span>
                    <h3 class="text-xl font-bold text-indigo-900 font-fun">Kerajaan Kutai & Tarumanagara (Abad 4–5 M)</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Prasasti Yupa -->
                    <div class="bg-white rounded-3xl border-2 border-amber-100 p-6 shadow-md hover:shadow-xl transition-all bubble-card flex flex-col sm:flex-row gap-5 items-center">
                        <div class="w-full sm:w-48 h-48 bg-amber-50 rounded-2xl flex-shrink-0 flex flex-col items-center justify-center p-3 text-center border border-amber-200">
                            <!-- SVG Representation of Yupa Prasasti -->
                            <svg class="w-24 h-24 text-amber-700 mb-1" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M30 15 C35 10, 65 10, 70 15 L75 85 C70 90, 30 90, 25 85 Z" fill="#D97706" stroke="#92400E" stroke-width="3"/>
                                <line x1="38" y1="30" x2="62" y2="30" stroke="#FEF3C7" stroke-width="2" stroke-linecap="round"/>
                                <line x1="35" y1="40" x2="65" y2="40" stroke="#FEF3C7" stroke-width="2" stroke-linecap="round"/>
                                <line x1="37" y1="50" x2="63" y2="50" stroke="#FEF3C7" stroke-width="2" stroke-linecap="round"/>
                                <line x1="36" y1="60" x2="60" y2="60" stroke="#FEF3C7" stroke-width="2" stroke-linecap="round"/>
                                <line x1="40" y1="70" x2="58" y2="70" stroke="#FEF3C7" stroke-width="2" stroke-linecap="round"/>
                            </svg>
                            <span class="text-xs font-bold text-amber-900 font-fun">Prasasti Yupa</span>
                            <span class="text-[10px] text-amber-700">Kutai, Kalimantan Timur</span>
                        </div>
                        <div class="space-y-2">
                            <span class="bg-amber-100 text-amber-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full">Aksara Pallawa & Sanskerta</span>
                            <h4 class="font-bold text-slate-800 text-lg font-fun">Bukti Sejarah Tulis Pertama</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Tiang batu yang mencatat kedermawanan Raja Mulawarman menyedekahkan 20.000 ekor sapi kepada kaum Brahmana.
                            </p>
                            <div class="bg-amber-50/80 p-3 rounded-2xl text-xs text-amber-900 border border-amber-200/60 mt-2">
                                <strong>💡 Relevansi Sekarang:</strong> Nilai kedermawanan, kepedulian sosial, serta pentingnya literasi/catatan tertulis dalam pemerintahan.
                            </div>
                        </div>
                    </div>

                    <!-- Prasasti Ciaruteun -->
                    <div class="bg-white rounded-3xl border-2 border-emerald-100 p-6 shadow-md hover:shadow-xl transition-all bubble-card flex flex-col sm:flex-row gap-5 items-center">
                        <div class="w-full sm:w-48 h-48 bg-emerald-50 rounded-2xl flex-shrink-0 flex flex-col items-center justify-center p-3 text-center border border-emerald-200">
                            <!-- SVG Representation of Ciaruteun -->
                            <svg class="w-24 h-24 text-emerald-700 mb-1" viewBox="0 0 100 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20 40 Q50 20 80 40 Q85 70 75 80 Q50 90 20 75 Z" fill="#059669" stroke="#065F46" stroke-width="3"/>
                                <!-- Footprints -->
                                <ellipse cx="40" cy="55" rx="6" ry="12" fill="#D1FAE5"/>
                                <ellipse cx="60" cy="55" rx="6" ry="12" fill="#D1FAE5"/>
                                <circle cx="40" cy="40" r="2" fill="#D1FAE5"/>
                                <circle cx="60" cy="40" r="2" fill="#D1FAE5"/>
                            </svg>
                            <span class="text-xs font-bold text-emerald-900 font-fun">Prasasti Ciaruteun</span>
                            <span class="text-[10px] text-emerald-700">Tarumanagara, Bogor</span>
                        </div>
                        <div class="space-y-2">
                            <span class="bg-emerald-100 text-emerald-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full">Manajemen Tata Air</span>
                            <h4 class="font-bold text-slate-800 text-lg font-fun">Telapak Kaki Raja Purnawarman</h4>
                            <p class="text-xs text-slate-600 leading-relaxed">
                                Melukiskan cetakan kaki raja seperti Dewa Wisnu. Raja Purnawarman membangun Sungai Gomati sepanjang 12 km untuk cegah banjir.
                            </p>
                            <div class="bg-emerald-50/80 p-3 rounded-2xl text-xs text-emerald-900 border border-emerald-200/60 mt-2">
                                <strong>💡 Relevansi Sekarang:</strong> Pentingnya tata kelola sungai dan infrastruktur penanggulangan banjir di kota modern.
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- PERIODE 2: KEJAYAAN MARITIM & CANDI (ABAD 7 - 10 M) -->
            <div class="space-y-4 pt-4">
                <div class="flex items-center gap-3">
                    <span class="bg-sky-400 text-indigo-950 font-bold px-3.5 py-1 rounded-2xl text-xs font-fun">PERIODE 2</span>
                    <h3 class="text-xl font-bold text-indigo-900 font-fun">Sriwijaya & Mataram Kuno (Abad 7–10 M)</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                    <!-- Perahu Cadik Sriwijaya -->
                    <div class="bg-white rounded-3xl border-2 border-sky-100 p-6 shadow-md hover:shadow-xl transition-all bubble-card flex flex-col justify-between">
                        <div>
                            <div class="w-full h-40 bg-sky-50 rounded-2xl flex flex-col items-center justify-center p-3 text-center border border-sky-200 mb-4">
                                <svg class="w-20 h-20 text-sky-600" viewBox="0 0 100 100" fill="none">
                                    <path d="M10 65 Q50 85 90 65 L80 50 L20 50 Z" fill="#0284C7"/>
                                    <path d="M50 15 L50 50 M50 20 L75 35 L50 35" stroke="#0369A1" stroke-width="3" fill="#E0F2FE"/>
                                    <path d="M5 75 L95 75" stroke="#38BDF8" stroke-width="3" stroke-dasharray="4"/>
                                </svg>
                                <span class="text-xs font-bold text-sky-900 font-fun">Armada Laut Sriwijaya</span>
                            </div>
                            <span class="bg-sky-100 text-sky-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Poros Maritim Dunia</span>
                            <h4 class="font-bold text-slate-800 text-base mt-1 font-fun">Penguasa Selat Malaka</h4>
                            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                                Sriwijaya menjadi pusat perdagangan internasional & pusat belajar ilmu agama Buddha di Asia Tenggara.
                            </p>
                        </div>
                        <div class="bg-sky-50/80 p-3 rounded-2xl text-[11px] text-sky-900 border border-sky-200/60 mt-3">
                            <strong>💡 Relevansi:</strong> Kedudukan strategis laut Indonesia dalam ekonomi global modern.
                        </div>
                    </div>

                    <!-- Candi Borobudur -->
                    <div class="bg-white rounded-3xl border-2 border-indigo-100 p-6 shadow-md hover:shadow-xl transition-all bubble-card flex flex-col justify-between">
                        <div>
                            <div class="w-full h-40 bg-indigo-50 rounded-2xl flex flex-col items-center justify-center p-3 text-center border border-indigo-200 mb-4">
                                <svg class="w-20 h-20 text-indigo-600" viewBox="0 0 100 100" fill="none">
                                    <path d="M15 75 L85 75 L75 55 L25 55 Z" fill="#6366F1"/>
                                    <path d="M25 55 L75 55 L65 38 L35 38 Z" fill="#4F46E5"/>
                                    <path d="M35 38 L65 38 L50 20 Z" fill="#3730A3"/>
                                    <circle cx="50" cy="18" r="4" fill="#EEF2FF"/>
                                </svg>
                                <span class="text-xs font-bold text-indigo-900 font-fun">Candi Borobudur</span>
                            </div>
                            <span class="bg-indigo-100 text-indigo-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Mahakarya Buddha</span>
                            <h4 class="font-bold text-slate-800 text-base mt-1 font-fun">Arsitektur & Astronomi Kuno</h4>
                            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                                Dibangun Wangsa Syailendra tanpa semen. Memiliki relief detail yang menggambarkan sains dan sosial.
                            </p>
                        </div>
                        <div class="bg-indigo-50/80 p-3 rounded-2xl text-[11px] text-indigo-900 border border-indigo-200/60 mt-3">
                            <strong>💡 Relevansi:</strong> Warisan Dunia UNESCO & penggerak industri ekonomi kreatif pariwisata.
                        </div>
                    </div>

                    <!-- Candi Prambanan -->
                    <div class="bg-white rounded-3xl border-2 border-pink-100 p-6 shadow-md hover:shadow-xl transition-all bubble-card flex flex-col justify-between">
                        <div>
                            <div class="w-full h-40 bg-pink-50 rounded-2xl flex flex-col items-center justify-center p-3 text-center border border-pink-200 mb-4">
                                <svg class="w-20 h-20 text-pink-600" viewBox="0 0 100 100" fill="none">
                                    <path d="M40 80 L60 80 L55 30 L45 30 Z" fill="#EC4899"/>
                                    <path d="M45 30 L55 30 L50 10 Z" fill="#BE185D"/>
                                    <path d="M20 80 L35 80 L30 45 L25 45 Z" fill="#F472B6"/>
                                    <path d="M65 80 L80 80 L75 45 L70 45 Z" fill="#F472B6"/>
                                </svg>
                                <span class="text-xs font-bold text-pink-900 font-fun">Candi Prambanan</span>
                            </div>
                            <span class="bg-pink-100 text-pink-800 text-[10px] font-bold px-2 py-0.5 rounded-full">Toleransi Beragama</span>
                            <h4 class="font-bold text-slate-800 text-base mt-1 font-fun">Candi Trimurti Hindu</h4>
                            <p class="text-xs text-slate-600 mt-1 leading-relaxed">
                                Didirikan Wangsa Sanjaya berdekatan dengan Borobudur, wujud tingginya toleransi agama masa itu.
                            </p>
                        </div>
                        <div class="bg-pink-50/80 p-3 rounded-2xl text-[11px] text-pink-900 border border-pink-200/60 mt-3">
                            <strong>💡 Relevansi:</strong> Bukti persatuan dan keharmonisan dalam perbedaan keyakinan.
                        </div>
                    </div>
                </div>
            </div>

            <!-- PERIODE 3: PUNCAK NUSANTARA - MAJAPAHIT (ABAD 13 - 16 M) -->
            <div class="space-y-4 pt-4">
                <div class="flex items-center gap-3">
                    <span class="bg-purple-400 text-indigo-950 font-bold px-3.5 py-1 rounded-2xl text-xs font-fun">PERIODE 3</span>
                    <h3 class="text-xl font-bold text-indigo-900 font-fun">Kerajaan Majapahit (Abad 13–16 M)</h3>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                    <!-- Gapura Wringin Lawang -->
                    <div class="bg-white rounded-3xl border-2 border-purple-100 p-6 shadow-md hover:shadow-xl transition-all bubble-card flex flex-col sm:flex-row gap-5 items-center">
                        <div class="w-full sm:w-48 h-48 bg-purple-50 rounded-2xl flex-shrink-0 flex flex-col items-center justify-center p-3 text-center border border-purple-200">
                            <svg class="w-24 h-24 text-purple-700 mb-1" viewBox="0 0 100 100" fill="none">
                                <path d="M20 85 L40 85 L40 20 L20 30 Z" fill="#8B5CF6"/>
                                <path d="M60 85 L80 85 L80 30 L60 20 Z" fill="#8B5CF6"/>
                                <path d="M40 85 L60 85 L60 75 L40 75 Z" fill="#DDD6FE"/>
                            </svg>
                            <span class="text-xs font-bold text-purple-900 font-fun">Candi Bentar Majapahit</span>
                            <span class="text-[10px] text-purple-700">Trowulan, Jawa Timur</span>
                        </div>
                        <div class="space-y-2">
                            <span class="bg-purple-100 text-purple-800 text-[11px] font-bold px-2.5 py-0.5 rounded-full">Seni Arsitektur Bata Merah</span>
