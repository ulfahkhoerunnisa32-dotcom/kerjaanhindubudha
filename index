    <script>
        // TAB NAVIGATION LOGIC
        function switchTab(tabId) {
            document.getElementById('sec-beranda').classList.add('hidden');
            document.getElementById('sec-memahami').classList.add('hidden');
            document.getElementById('sec-mengaplikasi').classList.add('hidden');
            document.getElementById('sec-merefleksi').classList.add('hidden');
            document.getElementById('sec-game').classList.add('hidden');
            document.getElementById('sec-tanya-guru').classList.add('hidden');

            const buttons = document.querySelectorAll('.tab-btn');
            buttons.forEach(btn => {
                btn.classList.remove('active');
                btn.classList.add('text-indigo-100');
            });

            document.getElementById('sec-' + tabId).classList.remove('hidden');

            const activeBtn = document.getElementById('tab-' + tabId);
            if (activeBtn) {
                activeBtn.classList.add('active');
                activeBtn.classList.remove('text-indigo-100');
            }
        }

        // MODAL GURU LOGIC
        function openModalGuru() {
            document.getElementById('modal-guru').classList.remove('hidden');
            document.getElementById('modal-guru').classList.add('flex');
        }
        function closeModalGuru() {
            document.getElementById('modal-guru').classList.add('hidden');
            document.getElementById('modal-guru').classList.remove('flex');
        }

        // WORKSPACE KOLABORASI LOGIC
        function pilihTugas(jenis) {
            document.getElementById('input-jenis-tugas').value = jenis;
            document.getElementById('workspace-kolaborasi').scrollIntoView({ behavior: 'smooth' });
        }

        function simpanKerjaKelompok() {
            const nama = document.getElementById('input-kelompok').value;
            const jenis = document.getElementById('input-jenis-tugas').value;
            const gagasan = document.getElementById('input-gagasan').value;

            if(!nama || !jenis || !gagasan) {
                alert("Mohon lengkapi Nama Kelompok, Jenis Tugas, dan Draf Gagasan terlebih dahulu ya!");
                return;
            }

            document.getElementById('notif-simpan').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('notif-simpan').classList.add('hidden');
            }, 5000);
        }

        function simpanRefleksi() {
            const r1 = document.getElementById('refleksi-1').value;
            const r2 = document.getElementById('refleksi-2').value;

            if(!r1 || !r2) {
                alert("Mohon isi kedua pertanyaan refleksi tersebut.");
                return;
            }

            document.getElementById('notif-refleksi').classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('notif-refleksi').classList.add('hidden');
            }, 5000);
        }

        // QUIZ GAME DATA & LOGIC
        const quizData = [
            {
                question: "Semboyan negara kita 'Bhinneka Tunggal Ika' berasal dari kitab sastra zaman Majapahit, yaitu...",
                options: [
                    "Kitab Sutasoma karya Mpu Tantular",
                    "Kitab Negarakertagama karya Mpu Prapanca",
                    "Kitab Arjunawiwaha karya Mpu Kanwa",
                    "Kitab Pararaton"
                ],
                answer: 0,
                explanation: "Semboyan pemersatu bangsa ditulis oleh Mpu Tantular dalam Kitab Sutasoma sebagai cermin toleransi agama pada masa Majapahit."
            },
            {
                question: "Kedatuan Sriwijaya sangat disegani di seluruh Asia karena menguasai jalur perairan strategis yaitu...",
                options: [
                    "Selat Sunda dan Laut Jawa",
                    "Selat Malaka dan Selat Sunda",
                    "Selat Makassar dan Laut Banda",
                    "Laut Flores dan Samudra Hindia"
                ],
                answer: 1,
                explanation: "Selat Malaka dan Sunda adalah urat nadi pelayaran internasional kuno tempat Sriwijaya menerapkan sistem keamanan dan perdagangan maritim."
            },
            {
                question: "Raja Purnawarman dari Tarumanagara membangun saluran air Gomati sepanjang 12 km. Dalam konteks modern, hal ini bertujuan...",
                options: [
                    "Membuat kolam renang istana raja",
                    "Pengelolaan irigasi pertanian & pencegahan banjir",
                    "Menyiapkan benteng perang melawan musuh",
                    "Pusat tempat pemancingan ikan"
                ],
                answer: 1,
                explanation: "Pembangunan saluran Gomati adalah bukti kecerdasan tata kelola air dan mitigasi bencana alam pada masa lalu."
            },
            {
                question: "Candi Borobudur dan Candi Prambanan dibangun berdekatan di Jawa Tengah. Hal ini membuktikan bahwa...",
                options: [
                    "Sering terjadi bentrokan antar umat beragama",
                    "Rakyat zaman dahulu dipaksa membangun candi",
                    "Tingginya sikap toleransi dan keharmonisan antar penganut Hindu dan Buddha",
                    "Hanya raja yang boleh masuk ke lokasi candi"
                ],
                answer: 2,
                explanation: "Pembangunan Candi Borobudur (Buddha) dan Prambanan (Hindu) yang berdekatan membuktikan tingginya tingkat toleransi masyarakat Nusantara kuno."
            },
            {
                question: "Mengapa prasasti-prasasti awal di Nusantara seperti Yupa di Kutai tertulis dalam bahasa Sanskerta?",
                options: [
                    "Karena bahasa Sanskerta adalah bahasa sehari-hari masyarakat umum",
                    "Karena Sanskerta adalah bahasa suci & penghormatan di lingkungan istana dan keagamaan",
                    "Karena diperintahkan oleh raja-raja dari Eropa",
                    "Karena belum ada bahasa lain yang bisa ditulis"
                ],
                answer: 1,
                explanation: "Bahasa Sanskerta merupakan bahasa akademis dan liturgi suci untuk mengabadikan momentum resmi kerajaan."
            }
        ];

        let currentQuestion = 0;
        let score = 0;

        function loadQuestion() {
            const q = quizData[currentQuestion];
            document.getElementById('quiz-progress').innerText = `Soal ${currentQuestion + 1} dari ${quizData.length}`;
            document.getElementById('quiz-question').innerText = q.question;

            const optionsContainer = document.getElementById('quiz-options');
            optionsContainer.innerHTML = '';

            document.getElementById('quiz-feedback').classList.add('hidden');
            document.getElementById('btn-next-quiz').classList.add('hidden');

            q.options.forEach((opt, idx) => {
                const btn = document.createElement('button');
                btn.className = 'w-full text-left p-4 rounded-2xl border-2 border-amber-200 hover:bg-amber-100 hover:border-amber-400 transition-all text-xs sm:text-sm font-semibold text-slate-700 flex items-center justify-between bg-white shadow-sm';
                btn.innerHTML = `<span>${opt}</span> <i class="fa-regular fa-circle text-amber-300"></i>`;
                btn.onclick = () => checkAnswer(idx, btn);
                optionsContainer.appendChild(btn);
            });
        }

        function checkAnswer(selectedIdx, btnElement) {
            const q = quizData[currentQuestion];
            const feedbackBox = document.getElementById('quiz-feedback');
            const allButtons = document.getElementById('quiz-options').children;

            for (let b of allButtons) {
                b.disabled = true;
                b.classList.add('cursor-not-allowed', 'opacity-70');
            }

            if (selectedIdx === q.answer) {
                score += 20;
                document.getElementById('score-display').innerText = score;
                btnElement.classList.remove('hover:bg-amber-100', 'border-amber-200');
                btnElement.classList.add('bg-emerald-100', 'border-emerald-500', 'text-emerald-950');
                
                feedbackBox.className = 'p-4 rounded-2xl text-xs sm:text-sm font-medium mb-4 bg-emerald-100 text-emerald-900 border-2 border-emerald-300 block';
                feedbackBox.innerHTML = `🎉 <strong>Jawabanmu Hebat!</strong> ${q.explanation}`;
            } else {
                btnElement.classList.remove('hover:bg-amber-100', 'border-amber-200');
                btnElement.classList.add('bg-rose-100', 'border-rose-500', 'text-rose-950');
                
                allButtons[q.answer].classList.add('bg-emerald-100', 'border-emerald-400');

                feedbackBox.className = 'p-4 rounded-2xl text-xs sm:text-sm font-medium mb-4 bg-rose-100 text-rose-900 border-2 border-rose-300 block';
                feedbackBox.innerHTML = `😅 <strong>Hampir Tepat!</strong> ${q.explanation}`;
            }

            document.getElementById('btn-next-quiz').classList.remove('hidden');
        }

        function nextQuestion() {
            currentQuestion++;
            if (currentQuestion < quizData.length) {
                loadQuestion();
            } else {
                document.getElementById('quiz-container').classList.add('hidden');
                document.getElementById('quiz-complete').classList.remove('hidden');
                document.getElementById('final-score').innerText = score;
            }
        }

        function resetQuiz() {
            currentQuestion = 0;
            score = 0;
            document.getElementById('score-display').innerText = '0';
            document.getElementById('quiz-complete').classList.add('hidden');
            document.getElementById('quiz-container').classList.remove('hidden');
            loadQuestion();
        }

        // TANYA GURU AI LOGIC (GEMINI API)
        function setPrompt(text) {
            document.getElementById('ai-input').value = text;
        }

        async function askAI() {
            const inputEl = document.getElementById('ai-input');
            const userText = inputEl.value.trim();
            if (!userText) return;

            const chatBox = document.getElementById('chat-box');

            const userMsgDiv = document.createElement('div');
            userMsgDiv.className = 'bg-indigo-600 text-white p-3.5 rounded-2xl max-w-xl ml-auto text-right font-medium text-xs sm:text-sm shadow-sm';
            userMsgDiv.innerHTML = `<strong>Kamu:</strong> ${userText}`;
            chatBox.appendChild(userMsgDiv);

            inputEl.value = '';
            chatBox.scrollTop = chatBox.scrollHeight;

            const loadingDiv = document.createElement('div');
            loadingDiv.className = 'bg-purple-100 text-purple-800 p-3.5 rounded-2xl max-w-xl italic text-xs sm:text-sm font-medium';
            loadingDiv.id = 'ai-loading';
            loadingDiv.innerHTML = `🤖 Guru AI sedang menyiapkan penjelasan terbaik...`;
            chatBox.appendChild(loadingDiv);
            chatBox.scrollTop = chatBox.scrollHeight;

            const systemPrompt = "Kamu adalah seorang Guru Sejarah SMA Kelas X yang sangat ramah, ceria, dan interaktif. Jelaskan materi sejarah Kerajaan Hindu-Buddha di Indonesia dengan analogi kehidupan sehari-hari anak SMA, gaya bahasa yang menyenangkan, serta tekankan nilai-nilai toleransi dan kebangsaan.";
            const apiKey = "";
            const apiUrl = `https://generativelanguage.googleapis.com/v1beta/models/gemini-3-flash-preview:generateContent?key=${apiKey}`;

            const payload = {
                contents: [{ parts: [{ text: userText }] }],
                systemInstruction: { parts: [{ text: systemPrompt }] }
            };

            try {
                const response = await fetch(apiUrl, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });

                const result = await response.json();
                document.getElementById('ai-loading').remove();

                const aiMsgDiv = document.createElement('div');
                aiMsgDiv.className = 'bg-purple-100 text-purple-950 p-4 rounded-2xl max-w-2xl border border-purple-200 text-xs sm:text-sm shadow-sm';

                if (result.candidates && result.candidates[0]?.content?.parts?.[0]?.text) {
                    const aiReply = result.candidates[0].content.parts[0].text;
                    aiMsgDiv.innerHTML = `<strong>Guru Sejarah AI:</strong><br>${aiReply.replace(/\n/g, '<br>')}`;
                } else {
                    aiMsgDiv.innerHTML = `<strong>Guru Sejarah AI:</strong> Maaf ya, ada kendala jaringan saat menjawab. Coba tanyakan sekali lagi ya!`;
                }
                chatBox.appendChild(aiMsgDiv);
            } catch (err) {
                if(document.getElementById('ai-loading')) {
                    document.getElementById('ai-loading').remove();
                }
                const errDiv = document.createElement('div');
                errDiv.className = 'bg-rose-100 text-rose-800 p-3.5 rounded-2xl max-w-xl text-xs sm:text-sm';
                errDiv.innerHTML = `<strong>Sistem:</strong> Maaf, tidak dapat terhubung ke server AI saat ini. Periksa koneksi internetmu ya!`;
                chatBox.appendChild(errDiv);
            }

            chatBox.scrollTop = chatBox.scrollHeight;
        }

        window.onload = function() {
            loadQuestion();
        };
    </script>
